{
  "manifest_version": 3,
  "name": "BiliSummary",
  "version": "1.2.0",
  "description": "B站视频字幕抓取 + AI 总结（默认 OpenCode Go / DeepSeek V4.1 Flash，且支持 DeepSeek 浏览器 SDK 与通用 OpenAI 兼容接口）",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "cookies", "contextMenus"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://opencode.ai/*",
    "*://chat.deepseek.com/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://open.bigmodel.cn/*",
    "https://dashscope.aliyuncs.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/video/*",
        "*://*.bilibili.com/list/*"
      ],
      "js": ["libs/wasm-solver.js", "js/providers.js", "js/state.js", "js/prompt.js", "js/settings.js", "js/subtitle.js", "js/chapter.js", "js/deepseek.js", "js/api-ai.js", "js/panel.js", "js/export.js", "content.js"],
      "css": ["css/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "BiliSummary",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["*://*.bilibili.com/*"]
    }
  ]
}
